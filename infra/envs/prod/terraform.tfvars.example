# prod: real Google Health data. Copy to terraform.tfvars (git-ignored) and replace every
# placeholder. Nothing here is a real project, person or address. infra/envs/README.md walks
# through each step; `terraform output -raw next_steps` prints what comes after an apply.
#
# This file will hold personal data (your name). Keep terraform.tfvars out of git (it is ignored)
# and treat the Terraform state as sensitive: Cloud Run's configuration carries the name too.

# --- Project (from infra/bootstrap, run once by the project owner) -----------------------------

project_id = "your-prod-project-id" # bootstrap output project_id (the existing project, D1)

# Optional, when a person runs Terraform: impersonate the deployer instead of using your own roles.
# deployer_service_account_email = "terraform-deployer@your-prod-project-id.iam.gserviceaccount.com"

# region = "us-central1"   # default; keep a free-tier e2-micro region that Hosting can rewrite to
# zone   = "us-central1-a" # default; must be inside region

# --- Patient (you; one value each feeds every service and the connect script) ------------------

patient_id                  = "PAT-0001"    # any identifier you choose; must NOT start with SYN-
patient_assigning_authority = "PULSEBRIDGE" # any short code (1-20 characters); PID-3.4 of cuff messages
patient_family_name         = "Family"      # your family name: PID-5.1 of the cuff simulator's messages
patient_given_name          = "Given"       # your given name: PID-5.2
time_zone                   = "America/New_York" # your own IANA time zone

# --- Alerts (required: a failed sync and "reconnect needed" must reach you) ----------------------

alert_email = "you@example.com"
# alert_notification_channels = ["projects/your-prod-project-id/notificationChannels/0000000000"]

# --- Ingest switch ------------------------------------------------------------------------------

# false for the FIRST apply. Set true for the second apply, after the connect script has written
# your Patient (README, steps 9 and 10).
ingest_enabled = false

# --- Images, by digest (README, step 7) ---------------------------------------------------------
# Paste the image build's "BEGIN tfvars" block here unchanged (seed_image is ignored with real data).
# Leave these out for the targeted applies of steps 3, 4 and 6.
# cuff_sim_image    = "us-central1-docker.pkg.dev/your-prod-project-id/pulsebridge-services/cuff-sim@sha256:<64 hex>"
# fhir_proxy_image  = "us-central1-docker.pkg.dev/your-prod-project-id/pulsebridge-services/fhir-proxy@sha256:<64 hex>"
# health_sync_image = "us-central1-docker.pkg.dev/your-prod-project-id/pulsebridge-services/health-sync@sha256:<64 hex>"
# seed_image        = "us-central1-docker.pkg.dev/your-prod-project-id/pulsebridge-services/seed@sha256:<64 hex>"
# v2_to_fhir_image  = "us-central1-docker.pkg.dev/your-prod-project-id/pulsebridge-services/v2-to-fhir@sha256:<64 hex>"

# --- Reviewer password ----------------------------------------------------------------------------
# prod refuses reviewer_password from tfvars: set and rotate it with
# scripts/secrets/set-reviewer-password.sh (README, step 5, and "Rotating the reviewer password").

# --- Optional -------------------------------------------------------------------------------------
# enable_iap_ssh     = true   # during the first-boot checklist only; set false again afterwards
# enable_cloud_nat   = false  # BILLED HOURLY; only if the VM cannot pull through Private Google Access
# trusted_proxy_hops = 2      # the default: measured behind Firebase Hosting (README, step 12, P1);
#                             # 1 only if nothing sits in front of the proxy's run.app URL
# public_origin      = "https://pulsebridge.example.com" # a custom domain (T30); default https://<project>.web.app
# openemr_scopes     = ["system/Patient.crs", "system/Encounter.crs", "system/Observation.cr"] # first-boot trial

# --- Image builds (T26; opt-in, README step 7) ------------------------------------------------------
# create_build_service_account = true  # a build account with only the roles a build needs
# build_trigger_repository     = "projects/your-prod-project-id/locations/us-central1/connections/github/repositories/pulsebridge" # after linking GitHub in the console
