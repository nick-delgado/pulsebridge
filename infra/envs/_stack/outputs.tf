# What the deployer and later tasks need without opening the console. Nothing here is a secret
# value: secrets appear by NAME only. The env roots re-export these outputs one for one.

output "environment" {
  description = "dev or prod."
  value       = var.environment
}

output "project_id" {
  description = "The project the stack runs in."
  value       = var.project_id
}

output "region" {
  description = "Region of the Cloud Run services, the job, the dataset and the subnets (the --region of every gcloud command in the runbook)."
  value       = var.region
}

# ---- the page and its front door --------------------------------------------------------------

output "dashboard_url" {
  description = "The address reviewers open: the Hosting origin (or public_origin). The page calls <dashboard_url>/api/... through the Hosting rewrite."
  value       = module.phr.public_origin
}

output "hosting_site_id" {
  description = "Firebase Hosting site ID (the --project/site the page deploy targets)."
  value       = module.phr.hosting_site_id
}

output "fhir_proxy_url" {
  description = "fhir-proxy's own run.app URL. NOT for the page: only for the first-deploy hop measurement (phr README, \"Verify on the first real deploy\", step 1), which compares a login through Hosting with one sent here directly."
  value       = module.phr.fhir_proxy_url
}

output "firebase_json" {
  description = "The firebase.json the page deploy writes to web/firebase.json (git-ignored) before `firebase deploy --only hosting` (T26; infra/envs/README.md, step 11)."
  value       = module.phr.firebase_json
}

# ---- FHIR store and secrets: what the connect script and the seeder need -----------------------

output "healthcare" {
  description = "Cloud Healthcare coordinates (short IDs, as the scripts and services take them) and the Pub/Sub names the replay commands use."
  value = {
    project_id                    = module.healthcare.project_id
    location                      = module.healthcare.location
    dataset_id                    = module.healthcare.dataset_name
    fhir_store_id                 = module.healthcare.fhir_store_name
    audit_fhir_store_id           = module.healthcare.audit_fhir_store_name
    hl7v2_store_id                = module.healthcare.hl7v2_store_name
    fhir_base_url                 = module.healthcare.fhir_base_url
    ingest_topic_name             = module.healthcare.ingest_topic_name
    ingest_subscription_name      = module.healthcare.ingest_subscription_name
    dead_letter_subscription_name = module.healthcare.dead_letter_subscription_name
  }
}

output "secret_name_prefix" {
  description = "Prefix of every Secret Manager secret ID (module identity's name_prefix). The connect script's PULSEBRIDGE_NAME_PREFIX / --name-prefix must equal it."
  value       = var.identity_name_prefix
}

output "secret_ids" {
  description = "Secret Manager secret IDs (names, never values) by key, for T27's scripts and the connect script."
  value       = module.identity.secret_ids
}

output "setup_env" {
  description = "Ready-to-source `export NAME='value'` lines for the connect script (scripts/connect-google-health) and for checks against the FHIR store: project, Healthcare coordinates, PATIENT_ID and the secret prefix. No secret value. Sensitive because it carries the patient identifier, a sensitive variable; read it with `terraform output -raw setup_env`. The patient's name, gender and birth date are NOT here: keep them in your own file outside the repository (connect script README, \"Run it\")."
  sensitive   = true
  value = join("\n", [
    "# PulseBridge ${var.environment}: generated by `terraform output -raw setup_env`. No secret values.",
    var.use_synthetic_data ? "# use_synthetic_data = true: NEVER run the Google Health connect script with this SYN- patient ID." : "# Real data: the connect script writes the Patient with this PATIENT_ID.",
    "export GCP_PROJECT_ID='${module.healthcare.project_id}'",
    "export HEALTHCARE_LOCATION='${module.healthcare.location}'",
    "export HEALTHCARE_DATASET_ID='${module.healthcare.dataset_name}'",
    "export FHIR_STORE_ID='${module.healthcare.fhir_store_name}'",
    "export PATIENT_ID='${local.ingestion_patient.id}'",
    "export PULSEBRIDGE_NAME_PREFIX='${var.identity_name_prefix}'",
    "",
  ])
}

# ---- ingestion -----------------------------------------------------------------------------

output "ingest_enabled" {
  description = "Whether the Scheduler job exists and the HL7v2 push subscription pushes. false until the setup step has run (D11)."
  value       = module.ingestion.ingest_enabled
}

output "push_enabled" {
  description = "Module healthcare's view of the same switch: the ingest subscription pushes to v2-to-fhir."
  value       = module.healthcare.push_enabled
}

output "scheduler_job_names" {
  description = "The Scheduler jobs that exist (empty while ingest_enabled is false)."
  value       = module.ingestion.scheduler_job_names
}

output "seed_job_name" {
  description = "The seeder Cloud Run job (synthetic data only, else null): `gcloud run jobs execute <name> --region <region> --args=--days,30 --wait` is the first seeding."
  value       = module.ingestion.seed_job_name
}

output "health_sync_service_name" {
  description = "The health-sync Cloud Run service (real data only, else null)."
  value       = module.ingestion.health_sync_service_name
}

output "v2_to_fhir_service_name" {
  description = "The v2-to-fhir Cloud Run service."
  value       = module.ingestion.v2_to_fhir_service_name
}

output "alert_policy_names" {
  description = "The ingestion alert policies by key (empty would mean nobody is told; the root requires a destination)."
  value       = module.ingestion.alert_policy_names
}

# ---- the edge VM -------------------------------------------------------------------------------

output "edge_vm" {
  description = "The edge VM, for the first-boot checklist and patching: name, zone, reserved internal IP (MLLP host and OpenEMR's address), the image it was created from, its data disk, and the hook metadata keys."
  value = {
    instance_name      = module.edge_vm.instance_name
    zone               = module.edge_vm.zone
    internal_ip        = module.edge_vm.internal_ip
    mllp_port          = module.edge_vm.mllp_port
    boot_image         = module.edge_vm.boot_image
    data_disk_name     = module.edge_vm.data_disk_name
    hook_metadata_keys = module.edge_vm.hook_metadata_keys
  }
}

output "openemr" {
  description = "OpenEMR's addresses on the VM (internal only) and the scopes its client is registered with."
  value = {
    site_address  = module.openemr.site_address
    fhir_base_url = module.openemr.fhir_base_url
    token_url     = module.openemr.token_url
    scopes        = module.openemr.scopes
    image         = module.openemr.image
  }
}

# ---- for the build and the root's check -----------------------------------------------------

output "build_service_account_email" {
  description = "The image-build service account (T26), or null without create_build_service_account. For a manual build: `gcloud builds submit --service-account projects/<project>/serviceAccounts/<this> ...`."
  value       = lookup(module.identity.service_account_emails, "build", null)
}

output "build_trigger_name" {
  description = "The Cloud Build trigger that builds the images on release tags (T26), or null without build_trigger_repository."
  value       = module.project_base.build_trigger_name
}

output "image_variable_names" {
  description = "The tfvars names the image build prints (services/README.md, \"Build in Cloud Build\"): paste its BEGIN/END tfvars block into terraform.tfvars unchanged."
  value       = ["cuff_sim_image", "fhir_proxy_image", "health_sync_image", "seed_image", "v2_to_fhir_image"]
}

output "patient_wiring" {
  description = "The patient values exactly as passed to module ingestion and module phr. The root's check compares the two; they must be equal, or the cuff path breaks silently. Sensitive because the patient ID is."
  sensitive   = true
  value = {
    ingestion = local.ingestion_patient
    phr       = local.phr_patient
  }
}

output "next_steps" {
  description = "The ordered post-apply procedure for this deployment, with its own names filled in (infra/envs/README.md has the full runbook). Print it with `terraform output -raw next_steps`."
  value = templatefile("${path.module}/templates/next-steps.txt.tftpl", {
    environment        = var.environment
    project_id         = var.project_id
    region             = var.region
    use_synthetic_data = var.use_synthetic_data
    ingest_enabled     = var.ingest_enabled
    seed_job_name      = coalesce(module.ingestion.seed_job_name, "-")
    vm_name            = module.edge_vm.instance_name
    vm_zone            = var.zone
    dashboard_url      = module.phr.public_origin
    secret_prefix      = var.identity_name_prefix
  })
}

output "demo_settings" {
  description = "The public demo's settings fhir-proxy gets (D16): recaptcha_min_score, session_ttl_seconds, sessions_per_address_per_hour, bot_checks_per_day (module phr's defaults where unset)."
  value       = module.phr.demo_settings
}
