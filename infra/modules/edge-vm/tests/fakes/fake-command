#!/usr/bin/env bash
# Stand-in for the system commands the edge VM startup script calls, for tests/startup_script.sh.
# The test links this one file under each command's name (docker, curl, mount, blkid, mkfs.ext4,
# timeout, date, sleep, ...) in a sandbox bin directory and runs the script with PATH set to that
# directory only, so no real disk, mount, swap, container or network call can happen.
#
# Every call (except `date`) is appended to "$FAKE_STATE/calls.log" as "<command> <args>". State
# that a real machine would keep (the disk's filesystem, mounts, swap, containers, images) lives in
# files under $FAKE_STATE, so a second run of the script sees what the first one did.
#
# Time is faked: `sleep N` and every simulated timeout advance a clock file, and `date +%s` reads
# it. So deadline-driven loops finish instantly, and the test can check how much (fake) time a run
# would have taken.
#
# Behaviour switches (environment variables set by a test case):
#   FAKE_PULL_FAIL=1          docker pull fails
#   FAKE_HANG="docker pull"   that command hangs: under `timeout` it times out (clock advances by
#                             the limit); called WITHOUT `timeout` it is logged as HANG and fails
#   FAKE_CURL_HANG=1          every curl call hangs until its --max-time (logged as HANG if none)
#   FAKE_ADAPTER_CRASH=1      the mllp-adapter container keeps restarting
#   FAKE_MARIADB_HEALTH=x     health status MariaDB reports (default healthy)
#   FAKE_MARIADB_INIT=fail    `docker run` of MariaDB on an empty data directory leaves it
#                             half-initialised (no .my-healthcheck.cnf); default: completed
#   FAKE_SECRET_MISSING=a,b   Secret Manager answers 404 for these file names ("all" for every one)
#   FAKE_CHMOD_FAIL=1         chmod fails on the decoded secret's temporary file
#   FAKE_DD_READ=error|short  reading the data disk with dd fails (I/O error) or returns fewer
#                             bytes than asked (a short read), while its size still looks right
#   FAKE_FSCK_RC=n            exit code of fsck.ext4
#   FAKE_SECRET, FAKE_TOKEN   the secret value and access token the fakes hand out
#   REAL_DATE, REAL_CHMOD,    paths of the real date, chmod and dd
#   REAL_DD

set -uo pipefail

: "${FAKE_STATE:?FAKE_STATE must point at the sandbox state directory}"
cmd=$(basename "$0")
if [ "$cmd" != date ]; then
  {
    printf '%s' "$cmd"
    printf ' %s' "$@"
    printf '\n'
  } >> "$FAKE_STATE/calls.log"
fi

containers="$FAKE_STATE/containers"
mkdir -p "$containers" "$FAKE_STATE/images" "$FAKE_STATE/networks"

clock_add() {
  local now
  now=$(cat "$FAKE_STATE/clock" 2> /dev/null || echo 0)
  echo $((now + $1)) > "$FAKE_STATE/clock"
}

hang() {
  echo "HANG: $* (no timeout around it)" >> "$FAKE_STATE/calls.log"
  exit 99
}

fake_docker() {
  local sub=${1:-}
  shift || true
  case "$sub" in
    info) return 0 ;;
    network)
      case "$1" in
        inspect) [ -e "$FAKE_STATE/networks/$2" ] ;;
        create) touch "$FAKE_STATE/networks/${*: -1}" ;;
        *) return 1 ;;
      esac
      ;;
    image)
      [ "$1" = inspect ] || return 1
      [ -e "$FAKE_STATE/images/$(printf '%s' "$2" | sha256sum | cut -c1-32)" ]
      ;;
    pull)
      if [ "${FAKE_HANG:-}" = "docker pull" ]; then hang docker pull "$@"; fi
      if [ "${FAKE_PULL_FAIL:-0}" = 1 ]; then
        echo "Error response from daemon: fake pull failure" >&2
        return 1
      fi
      touch "$FAKE_STATE/images/$(printf '%s' "${*: -1}" | sha256sum | cut -c1-32)"
      ;;
    container)
      [ "$1" = inspect ] || return 1
      shift
      local format="" name
      if [ "$1" = --format ]; then
        format=$2
        shift 2
      fi
      name=$1
      [ -d "$containers/$name" ] || {
        echo "Error: No such container: $name" >&2
        return 1
      }
      case "$format" in
        "") echo "[{}]" ;;
        *Labels*) cat "$containers/$name/label" ;;
        *RestartCount*)
          if [ "$name" = mllp-adapter ] && [ "${FAKE_ADAPTER_CRASH:-0}" = 1 ]; then
            echo $(($(cat "$containers/$name/restarts") + 1)) > "$containers/$name/restarts"
            echo restarting > "$containers/$name/status"
          fi
          echo "$(cat "$containers/$name/status") $(cat "$containers/$name/restarts")"
          ;;
        *Health*) echo "${FAKE_MARIADB_HEALTH:-healthy}" ;;
        *) return 1 ;;
      esac
      ;;
    run)
      local name="" label="" args=("$@")
      while [ $# -gt 0 ]; do
        case "$1" in
          --name) name=$2; shift 2 ;;
          --label) label=${2#*=}; shift 2 ;;
          *) shift ;;
        esac
      done
      [ -n "$name" ] || return 1
      if [ -d "$containers/$name" ]; then
        echo "docker: Error response from daemon: Conflict. The container name \"/$name\" is already in use." >&2
        return 125
      fi
      mkdir -p "$containers/$name"
      echo "$label" > "$containers/$name/label"
      echo running > "$containers/$name/status"
      echo 0 > "$containers/$name/restarts"
      printf '%s\n' "${args[@]}" > "$containers/$name/args"
      printf '%s\0' "${args[@]}" > "$containers/$name/args0" # exact, for multi-line arguments
      # MariaDB's first initialisation, as far as the data directory shows it: on an empty
      # bind-mounted /var/lib/mysql it leaves the mysql schema, InnoDB files and, if it completed,
      # .my-healthcheck.cnf (FAKE_MARIADB_INIT=fail: it stopped before that, as on prod, T42).
      if [ "$name" = mariadb ]; then
        local a src=""
        for a in "${args[@]}"; do
          case "$a" in
            type=bind,source=*,target=/var/lib/mysql)
              src=${a#type=bind,source=}
              src=${src%,target=/var/lib/mysql}
              ;;
          esac
        done
        if [ -n "$src" ] && [ -d "$src" ] && [ -z "$(ls -A "$src")" ]; then
          mkdir -p "$src/mysql"
          : > "$src/ibdata1"
          if [ "${FAKE_MARIADB_INIT:-ok}" != fail ]; then : > "$src/.my-healthcheck.cnf"; fi
        fi
      fi
      echo "fakecontainerid-$name"
      ;;
    start)
      [ -d "$containers/$1" ] || return 1
      echo running > "$containers/$1/status"
      echo "$1"
      ;;
    stop)
      local name=${*: -1}
      [ -d "$containers/$name" ] || return 1
      echo exited > "$containers/$name/status"
      echo "$name"
      ;;
    rm)
      local name=${*: -1} force=0
      [ "$1" = --force ] && force=1
      [ -d "$containers/$name" ] || return 1
      # Like Docker: a running (or restarting) container is removed only with --force.
      case "$(cat "$containers/$name/status")" in
        running | restarting)
          if [ "$force" = 0 ]; then
            echo "Error response from daemon: cannot remove container \"/$name\": container is running: stop the container before removing or force remove" >&2
            return 1
          fi
          ;;
      esac
      rm -rf "${containers:?}/$name"
      ;;
    logs)
      case "${*: -1}" in
        mariadb)
          echo "[ERROR] [Entrypoint]: Unable to start server."
          ;;
        *)
          echo "flag provided but not defined: -fake_bad_flag"
          echo "Usage of /usr/mllp_adapter/mllp_adapter:"
          ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

fake_curl() {
  local output="" writeout="" url="" header_stdin=0 auth="" max_time=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --output) output=$2; shift 2 ;;
      --write-out) writeout=$2; shift 2 ;;
      --max-time) max_time=$2; shift 2 ;;
      --connect-timeout) shift 2 ;;
      --header)
        [ "$2" = "@-" ] && header_stdin=1
        shift 2
        ;;
      --silent | --fail | --show-error) shift ;;
      *) url=$1; shift ;;
    esac
  done
  if [ "$header_stdin" = 1 ]; then
    IFS= read -r auth || true
  fi
  if [ "${FAKE_CURL_HANG:-0}" = 1 ]; then
    [ -n "$max_time" ] || hang curl "$url"
    clock_add "$max_time"
    [ -n "$writeout" ] && printf '000'
    return 28 # curl: operation timed out
  fi

  case "$url" in
    */instance/service-accounts/default/token)
      printf '{"access_token":"%s","expires_in":3599,"token_type":"Bearer"}' "$FAKE_TOKEN"
      ;;
    */instance/attributes/pulsebridge-hook-*)
      local hook=${url##*/pulsebridge-hook-}
      [ -f "$FAKE_STATE/hooks/$hook" ] || return 22
      cp "$FAKE_STATE/hooks/$hook" "$output"
      ;;
    */versions/latest:access)
      local code secret_name
      secret_name=${url%/versions/latest:access}
      secret_name=${secret_name##*/secrets/}
      if [ "$auth" != "Authorization: Bearer $FAKE_TOKEN" ]; then
        code=401
        printf '{"error":{"code":401}}' > "$output"
      elif [ "${FAKE_SECRET_MISSING:-}" = all ] || [[ ",${FAKE_SECRET_MISSING:-}," == *",${secret_name#pulsebridge-},"* ]]; then
        code=404
        printf '{"error":{"code":404,"status":"NOT_FOUND"}}' > "$output"
      else
        code=200
        printf '{\n  "name": "%s/versions/1",\n  "payload": {\n    "data": "%s",\n    "dataCrc32c": "1234"\n  }\n}\n' \
          "${url%/versions/latest:access}" "$(printf '%s' "$FAKE_SECRET" | base64 -w0)" > "$output"
      fi
      [ -n "$writeout" ] && printf '%s' "$code"
      ;;
    *) return 6 ;;
  esac
}

case "$cmd" in
  docker) fake_docker "$@" ;;
  docker-credential-gcr)
    # The real helper writes $HOME/.docker/config.json; record where it would write.
    mkdir -p "$DOCKER_CONFIG"
    printf '{"credHelpers":{"%s":"gcr"}}\n' "${2#--registries=}" > "$DOCKER_CONFIG/config.json"
    ;;
  curl) fake_curl "$@" ;;
  timeout)
    # timeout <seconds> <command...>: a command named in FAKE_HANG times out after <seconds>.
    limit=$1
    shift
    if [ -n "${FAKE_HANG:-}" ] && [[ "$*" == "$FAKE_HANG"* ]]; then
      clock_add "$limit"
      exit 124
    fi
    exec "$@"
    ;;
  date)
    if [ "${1:-}" = "+%s" ]; then
      echo $((1700000000 + $(cat "$FAKE_STATE/clock" 2> /dev/null || echo 0)))
    else
      exec "$REAL_DATE" "$@"
    fi
    ;;
  sleep) clock_add "${1%.*}" ;;
  dd)
    # Only reads of the data disk (if=.../google-edge-data) are affected by FAKE_DD_READ.
    if [[ " $* " == *" if="*google-edge-data* ]]; then
      case "${FAKE_DD_READ:-}" in
        error)
          echo "dd: error reading: Input/output error" >&2
          exit 1
          ;;
        short)
          "$REAL_DD" "$@" | head -c 1048576
          exit 0
          ;;
      esac
    fi
    exec "$REAL_DD" "$@"
    ;;
  chmod)
    if [ "${FAKE_CHMOD_FAIL:-0}" = 1 ] && [[ "${*: -1}" == *.decoded.tmp ]]; then
      echo "chmod: changing permissions: Operation not permitted" >&2
      exit 1
    fi
    exec "$REAL_CHMOD" "$@"
    ;;
  blkid)
    # blkid -p -o value -s TYPE <dev>. Like util-linux, exit 2 ("nothing found") is returned for
    # a blank device, an unreadable one and unrecognised contents alike; only a filesystem this
    # fake "made" (state file fstype) is recognised. ERR models exit 4 (usage error).
    fs=$(cat "$FAKE_STATE/fstype" 2> /dev/null || true)
    case "$fs" in
      "") exit 2 ;;
      ERR) exit 4 ;;
      *) echo "$fs" ;;
    esac
    ;;
  wipefs)
    # wipefs --no-act <dev>: lists signatures it finds; nothing for a blank device.
    if [ -f "$FAKE_STATE/wipefs_signature" ]; then cat "$FAKE_STATE/wipefs_signature"; fi
    ;;
  mkfs.ext4)
    echo ext4 > "$FAKE_STATE/fstype"
    printf 'fake-ext4-superblock' | dd of="${*: -1}" bs=1 seek=1024 conv=notrunc status=none
    ;;
  fsck.ext4) exit "${FAKE_FSCK_RC:-0}" ;;
  resize2fs) exit 0 ;;
  mount)
    # mount -t ext4 -o <opts> <dev> <dir>
    dev=${*: -2:1}
    dir=${*: -1}
    [ -d "$dir" ] || exit 32
    echo "$dev $dir ext4 rw,discard 0 0" >> "$FAKE_STATE/proc_mounts"
    ;;
  mkswap) exit 0 ;;
  swapon) echo "${*: -1} file 2097148 0 -2" >> "$FAKE_STATE/proc_swaps" ;;
  fallocate)
    # fallocate -l <n>M <file>; a sparse file of the right size is enough for the size check.
    size=$2
    truncate -s "$((${size%M} * 1024 * 1024))" "$3"
    ;;
  *)
    echo "fake-command: no fake for $cmd" >&2
    exit 127
    ;;
esac
