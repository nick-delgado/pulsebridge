# Copy to .env.local (git-ignored) to configure `npm run dev:http` or `npm run build`.
# Placeholders only: never commit a real URL, and never put a secret in a VITE_ variable
# (Vite copies every VITE_ value into the public bundle).
#
# fhir-proxy's base PATH on the page's own origin. Leave empty for "/api" (the Firebase Hosting
# rewrite, D4). Same-origin only: the session cookie is SameSite=Strict (D16).
VITE_FHIR_PROXY_URL=
# `npm run dev:http` only: the real proxy's origin, for example https://proxy.example.test.
# Vite's dev server forwards the path above to it, so the browser stays on one origin.
PULSEBRIDGE_DEV_PROXY_TARGET=
