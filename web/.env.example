# Copy to .env.local (git-ignored) to point `npm run dev:http` or `npm run build` at a proxy.
# Leave it empty to call "/api" on the page's own origin (the Firebase Hosting rewrite, D4).
# Placeholder only: never commit a real URL, and never put a secret in a VITE_ variable
# (Vite copies every VITE_ value into the public bundle).
VITE_FHIR_PROXY_URL=
